# ==========================================
# SparkOne 创意协作中心 - Supabase 配置
# ==========================================
# 1. 在 https://supabase.com 注册或新建项目
# 2. 在项目设置 Project Settings -> API 中获取 URL 和 anon public 密钥
# 3. 复制此文件为 .env.local 并填入下方对应变量
# ==========================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
